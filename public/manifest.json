{
  "manifest_version": 3,
  "key": "",
  "name": "Simple Reader",
  "version": "0.3.1",
  "description": "Read the page aloud and highlight words as it reads. Free, local, no API keys.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Simple Reader — read this page aloud",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "background": { "service_worker": "service-worker.js" },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "permissions": ["activeTab", "scripting", "storage", "contextMenus", "alarms"],
  "host_permissions": [
    "https://api.github.com/*",
    "https://github.com/*",
    "https://release-assets.githubusercontent.com/*"
  ],
  "commands": {
    "read": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Read the selected text, or open Simple Reader on the page"
    },
    "play-pause": {
      "suggested_key": { "default": "Alt+Shift+K" },
      "description": "Play / pause reading"
    }
  }
}
